{
  "name": "cal-todo-backend",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "test:coverage": "node --env-file=.env.test --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90",
    "seed": "node --env-file=.env src/db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
